# ─── SAATHI AI configuration ───────────────────────────────────────────────
# Copy to `.env` and fill in what you have. Every integration is optional:
# anything left blank falls back to a simulated/local implementation so the
# full demo always works.

# Claude (reasoning + routing). https://platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Sarvam AI (speech-to-text, text-to-speech). https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v4
SARVAM_SPEAKER=shubh

# Vobiz (outbound phone calls for fraud verification). https://vobiz.ai
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=
VOBIZ_TO_NUMBER=

# Telegram Bot API (approvals, purchase orders, reminders, alerts).
# Create a bot with @BotFather. Leave chat ids blank and send /start to your
# bot — SAATHI adopts the first chat it sees while polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_SUPPLIER_CHAT_ID=
TELEGRAM_CUSTOMER_CHAT_ID=
# Scam Shield family alerts (defaults to the main chat)
TELEGRAM_FAMILY_CHAT_ID=
TELEGRAM_POLLING=true

# Google Sheets (hackathon data backend). Share the sheet with the service
# account email as Editor.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Public URL of this backend (ngrok etc.) — needed only for Vobiz/Telegram webhooks.
PUBLIC_BASE_URL=
FRONTEND_ORIGIN=http://localhost:3000
DEMO_STEP_DELAY=2.2
